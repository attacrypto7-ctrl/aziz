{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@libs/*": ["libs/*/src"],
      "@libs/shared-types": ["libs/shared-types/src"],
      "@libs/database": ["libs/database/src"],
      "@libs/groq-client": ["libs/groq-client/src"],
      "@api/*": ["apps/api/src/*"],
      "@worker/*": ["apps/worker/src/*"],
      "@wa-gateway/*": ["apps/wa-gateway/src/*"]
    }
  },
  "include": ["apps/*/src/**/*", "libs/*/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
